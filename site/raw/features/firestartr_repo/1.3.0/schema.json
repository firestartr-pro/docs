{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "firestartr_repo args",
  "type": "object",
  "description": "This feature provides the initial setup for the `.firestartr` configuration repository, which holds the apps, platforms, providers, and Docker registry definitions used by Firestartr workflows.",
  "properties": {
    "feature_name": {
      "const": "firestartr_repo"
    }
  },
  "fileManifest": [
    {
      "src": "apps/.gitkeep",
      "dest": "apps/.gitkeep",
      "user_managed": false
    },
    {
      "src": "docker_registries/.gitkeep",
      "dest": "docker_registries/.gitkeep",
      "user_managed": false
    },
    {
      "src": "platforms/.gitkeep",
      "dest": "platforms/.gitkeep",
      "user_managed": false
    },
    {
      "src": "providers/.gitkeep",
      "dest": "providers/.gitkeep",
      "user_managed": false
    },
    {
      "src": "validations/.gitkeep",
      "dest": "validations/.gitkeep",
      "user_managed": false
    }
  ],
  "version": "1.3.0"
}