{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "features_repo args",
  "type": "object",
  "description": "This feature provides the initial setup for the Firestartr features monorepo, your organization's private registry of reusable, Mustache-templated Firestartr features.",
  "properties": {
    "feature_name": {
      "const": "features_repo"
    },
    "docs_org": {
      "type": "string",
      "description": "The GitHub organization that owns the repository where the generated feature schemas are promoted.",
      "default": "firestartr-pro",
      "examples": [
        "your-org"
      ]
    },
    "docs_repo_name": {
      "type": "string",
      "description": "The repository that receives the generated feature schemas.",
      "default": "docs",
      "examples": [
        "docs"
      ]
    },
    "disable_promote_schemas": {
      "type": "string",
      "description": "Whether to disable the workflow that promotes the generated feature schemas to the docs repository.",
      "default": "",
      "examples": [
        "true"
      ]
    }
  },
  "fileManifest": [
    {
      "src": "packages/.gitkeep",
      "dest": "packages/.gitkeep",
      "user_managed": false
    },
    {
      "src": "docs/README.md",
      "dest": "README.md",
      "user_managed": false
    },
    {
      "src": "package.json",
      "dest": "package.json",
      "user_managed": false
    },
    {
      "src": "pnpm-workspace.yaml",
      "dest": "pnpm-workspace.yaml",
      "user_managed": false
    },
    {
      "src": "pnpm-lock.yaml",
      "dest": "pnpm-lock.yaml",
      "user_managed": false
    },
    {
      "src": ".github/actionlint-matcher.json",
      "dest": ".github/actionlint-matcher.json",
      "user_managed": false
    },
    {
      "src": ".github/workflows/pr_verify.yaml",
      "dest": ".github/workflows/pr_verify.yaml",
      "user_managed": false
    },
    {
      "src": ".github/workflows/promote-schemas.yaml",
      "dest": ".github/workflows/promote-schemas.yaml",
      "user_managed": false
    },
    {
      "src": "scripts/generate-schemas.js",
      "dest": "scripts/generate-schemas.js",
      "user_managed": false
    },
    {
      "src": "scripts/arg-formats.js",
      "dest": "scripts/arg-formats.js",
      "user_managed": false
    },
    {
      "src": "scripts/verify-schemas-match.js",
      "dest": "scripts/verify-schemas-match.js",
      "user_managed": false
    },
    {
      "src": "scripts/build-versions-index.js",
      "dest": "scripts/build-versions-index.js",
      "user_managed": false
    },
    {
      "src": "generic-fixtures/cr.yaml",
      "dest": "generic-fixtures/cr.yaml",
      "user_managed": false
    },
    {
      "src": "packages/hello-world/CHANGELOG.md",
      "dest": "packages/hello-world/CHANGELOG.md",
      "user_managed": true
    },
    {
      "src": "packages/hello-world/templates/hello.md",
      "dest": "packages/hello-world/templates/hello.md",
      "user_managed": true
    },
    {
      "src": "packages/hello-world/templates/docs/README.md",
      "dest": "packages/hello-world/templates/docs/README.md",
      "user_managed": true
    },
    {
      "src": "packages/hello-world/config.yaml",
      "dest": "packages/hello-world/config.yaml",
      "user_managed": true
    },
    {
      "src": "packages/hello-world/package.json",
      "dest": "packages/hello-world/package.json",
      "user_managed": true
    },
    {
      "src": "packages/hello-world/render_tests.yaml",
      "dest": "packages/hello-world/render_tests.yaml",
      "user_managed": true
    }
  ],
  "version": "1.4.1"
}
