{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "catalog_repo args",
  "type": "object",
  "properties": {
    "feature_name": {
      "const": "catalog_repo"
    },
    "crontab": {
      "type": "string",
      "description": "The cron schedule for catalog hydration.",
      "default": "0 */6 * * *",
      "examples": [
        "0 */6 * * *"
      ]
    },
    "cli_version_constraint": {
      "type": "string",
      "description": "The minimum Firestartr CLI version required by the workflows.",
      "default": ">=2.9.0",
      "examples": [
        ">=2.9.0"
      ]
    },
    "cli_version_check_enabled": {
      "type": "string",
      "description": "Whether the CLI version check runs before the workflows.",
      "default": "true",
      "examples": [
        "true"
      ]
    }
  },
  "fileManifest": [
    {
      "src": ".config/.gitkeep",
      "dest": ".config/.gitkeep",
      "user_managed": false
    },
    {
      "src": ".github/workflows/hydrate.yaml",
      "dest": ".github/workflows/hydrate.yaml",
      "user_managed": false
    }
  ],
  "description": "no description",
  "version": "1.6.0"
}
