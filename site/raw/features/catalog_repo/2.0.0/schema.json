  "fileManifest": [
    {
      "src": ".config/.gitkeep",
      "dest": ".config/.gitkeep",
      "user_managed": false
    },
    {
      "src": ".github/workflows/hydrate.yaml",
      "dest": ".github/workflows/hydrate.yaml",
      "user_managed": false
    }
  ],
  "description": "This feature provides the initial setup for the catalog repository, which stores the rendered Backstage catalog Custom Resources generated by hydrating all claims from the claims repository.",
  "version": "2.0.0"
}
