,15})\\.(?:0|[1-9]\\d{0,15})(?:\\.[xX*])?|(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)??(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)??)|(?:>=|<=|>|<|=|~|\\^)?\\s*(?:v)?(?:[xX*](?:\\.[xX*](?:\\.[xX*])?)?|(?:0|[1-9]\\d{0,15})(?:\\.[xX*](?:\\.[xX*])?)?|(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})(?:\\.[xX*])?|(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)??(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)??)(?:\\s+(?:>=|<=|>|<|=|~|\\^)?\\s*(?:v)?(?:[xX*](?:\\.[xX*](?:\\.[xX*])?)?|(?:0|[1-9]\\d{0,15})(?:\\.[xX*](?:\\.[xX*])?)?|(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})(?:\\.[xX*])?|(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})\\.(?:0|[1-9]\\d{0,15})(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)??(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)??))*))*$",
      "description": "The minimum Firestartr CLI version required by the workflows. Must be a valid npm semver range: whitespace-separated AND-ed items, each an optional comparator (`>=`, `<=`, `>`, `<`, `=`, `~`, `^`) followed by a partial version (`1.2`, `1.2.x`, `*`) with wildcards only in trailing positions, a bare/partial version, or a hyphen range (`1.2.3 - 2.3.4`) standing alone in its `||` branch; separate OR branches with `||`. Examples: `>=2.9.0`, `~1.2`, `1.2.3 - 2.3.4`, `1.x || >=2.0.0`.",
